<!DOCTYPE html>
<html>
<head>
    <title>Instagram Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #2e8bff;
            --accent: #e07a5f;
            --white: #ffffff;
            --grey: #f5f5f5;
            --success: #27ae60;
            --error: #e74c3c;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            background: var(--grey);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-container {
            background: var(--white);
            max-width: 400px;
            min-height: 500px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            padding: 40px 30px;
            display: grid;
            grid-template-rows: 1fr auto 1fr;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .logo-circle {
            width: 80px;
            height: 80px;
            border: 5px solid var(--accent);
            border-radius: 50%;
            background: linear-gradient(45deg, #fbc2eb, #a6d1fa);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-text {
            font-size: 28px;
            font-weight: 700;
            color: #2e8bff;
            text-align: center;
        }

        .login-form {
            background: #f8f9fa;
            padding: 30px;
            border-radius: 20px;
        }

        .form-title {
            font-size: 24px;
            margin-bottom: 20px;
            color: #000000;
        }

        .field-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 25px;
        }

        .input-box {
            width: 100%;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 25px;
            font-size: 14px;
            background: #ffffff;
            outline: none;
        }

        .error-msg {
            color: var(--error);
            font-size: 12px;
            margin-top: 5px;
        }

        .recall {
            color: var(--accent);
            cursor: pointer;
            text-decoration: none;
        }

        .password-eye {
            position: absolute;
            right: 15px;
            top: 20px;
            cursor: pointer;
            font-size: 16px;
        }

        .eye-icon {
            color: var(--primary);
        }

        .eye-icon.active {
            color: #777;
        }

        .button {
            background: var(--primary);
            color: var(--white);
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .button:hover {
            background: #1d4ed8;
        }

        .social-buttons {
            display: flex;
            flex-direction: column;
            margin-top: 25px;
            gap: 15px;
        }

        .social-btn {
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 12px;
            border-radius: 25px;
            font-size: 14px;
            color: var(--white);
            background: var(--accent);
            transition: all 0.3s ease;
        }

        .social-btn:hover {
            background: #c06c5d;
        }

        .social-btn .fab {
            margin-right: 10px;
            font-size: 18px;
        }

        .eye-icon {
            color: #2e8bff;
            transition: color 0.3s ease;
        }

        @media (max-width: 500px) {
            .login-container {
                width: 95%;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo-area">
            <div class="logo-circle">
                <i class="fas fa-instagram"></i>
            </div>
            <div class="logo-text">Instagram</div>
        </div>
        <form class="login-form">
            <h2 class="form-title">Instant Access</h2>
            <div class="field-group">
                <input type="email" class="input-box" placeholder="   Email or Phone Number"
                       aria-label="Email or Phone Number">
                <div class="error-msg" id="email-error">Invalid email format</div>
            </div>
            <div class="field-group">
                <input type="password" class="input-box" placeholder="   Password"
                       aria-label="Password"><i class="password-eye eye-icon" aria-label="Show/Hide Password"></i>
                <span class="error-msg" id="password-error">Password must be at least 6 characters</span>
            </div>
            <button class="button">
                <div class="loader">...</div>
                <span>Log In</span>
            </button>
            <p>Don't have an account? <a href="signup.html" style="color: #2e8bff; text-decoration: none;">Sign up</a></p>
        </form>
        <div class="social-buttons">
            <div class="social-btn">
                <i class="fab fa-facebook-f"></i>Log in with Facebook</div>
            </div>
            <div class="social-btn">
                <i class="fab fa-google-plus-g"></i>Log in with Google</div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const inputEmail = document.querySelector('.input-box:first-of-type');
            const inputPassword = document.querySelector('.input-box:last-of-type');
            const emailError = document.getElementById('email-error');
            const passwordError = document.getElementById('password-error');
            const eyeIcon = document.querySelector('.password-eye');

            eyeIcon.addEventListener('click', () => {
                const currentType = inputPassword.type;
                inputPassword.type = currentType === 'password' ? 'text' : 'password';
                eyeIcon.classList.toggle('active');
            });

            // Form validation
            function validateForm() {
                let isValid = true;

                // Email validation
                const email = inputEmail.value;
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email) || !email) {
                    emailError.textContent = 'Valid email required';';
                    isValid = false;
                } else {
                    emailError.textContent = '';
                }

                // Password validation
                const password = inputPassword.value;
                if (!password) {
                    passwordError.textContent = 'Password required';';
                    isValid = false;
                } else if (password.length < 6) {
                    passwordError.textContent = 'Minimum 6 characters required';';
                    isValid = false;
                } else {
                    passwordError.textContent = '';
                }

                return isValid;
            }

            const loginButton = document.querySelector('.button');
            loginButton.addEventListener('click', (e) => {
                e.preventDefault();
                if (!validateForm()) return;

                // Add authentication logic here
                alert('Authentication successful!');

                // Replace with actual redirect logic
                window.location.href = '/dashboard.html';
            });
        });
    </script>
</body>
</html>